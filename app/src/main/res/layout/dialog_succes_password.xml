<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    app:cardBackgroundColor="#802C3E"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">

        <!-- Lingkaran Ikon Centang -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_circle_peach"
            android:gravity="center">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_thick"
                app:tint="#802C3E"
                android:contentDescription="Check Icon" />
        </FrameLayout>

        <!-- Teks Pesan Berhasil -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Password Berhasil Di Ubah! saatnya masuk ke akun kamu lalu bikin kue favoritmu🧁"
            android:textColor="#FFF9F8"
            android:textSize="14sp" />

        <!-- Tombol Kembali Ke Login -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKembaliKeLogin"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FCEBE5"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="32dp"
            android:text="Kembali Ke Login"
            android:textAllCaps="false"
            android:textColor="#802C3E"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="22dp"
            app:strokeColor="#802C3E"
            app:strokeWidth="1dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>