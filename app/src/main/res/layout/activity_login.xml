<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCEBE5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Gambar Pastry & Logo Bakery's -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="420dp">

            <ImageView
                android:id="@+id/ivHeaderLogin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_pastry_login"
                android:contentDescription="Header Pastry" />

            <!-- Overlay Gradasi Halus ke Background Peach -->
            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bg_gradient_transparent_to_peach" />

            <!-- Logo Bakery's Bulat Presisi -->
            <ImageView
                android:id="@+id/ivLogoLogin"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"
                android:src="@mipmap/ic_launcher_foreground"
                android:contentDescription="Logo Bakery's" />

        </RelativeLayout>

        <!-- Card Container Utama -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#802C3E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Input Username (Kotak Cream + Border Maroon) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#FCEBE5"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#802C3E"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/circle_user_round"
                            app:tint="#802C3E"
                            android:contentDescription="User Icon" />

                        <EditText
                            android:id="@+id/etLoginUsername"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:hint="Username"
                            android:inputType="text"
                            android:textColor="#802C3E"
                            android:textColorHint="#802C3E"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Input Password (Kotak Cream + Border Maroon) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#FCEBE5"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#802C3E"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock_outline"
                            app:tint="#802C3E"
                            android:contentDescription="Lock Icon" />

                        <EditText
                            android:id="@+id/etLoginPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:hint="Password"
                            android:inputType="textPassword"
                            android:textColor="#802C3E"
                            android:textColorHint="#802C3E"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Text Lupa Password -->
                <TextView
                    android:id="@+id/tvLupaPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:text="Lupa Password? Klik Disini"
                    android:textColor="#802C3E"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Tombol Masuk -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMasukLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="#802C3E"
                    android:text="Masuk"
                    android:textAllCaps="false"
                    android:textColor="#FFF9F8"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:cornerRadius="26dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>