<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F8"
    android:orientation="vertical">

    <!-- Header Halaman Draft Resep -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/bakery_mark"
            android:contentDescription="Kembali" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Draft Resep"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar resep yang tersimpan sebagai draf"
                android:textColor="#8D6E63"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tombol Reload -->
        <ImageView
            android:id="@+id/btnRefreshDraft"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#802C3E"
            android:contentDescription="Muat Ulang" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EED5CE" />

    <!-- Kontainer List Draft Resep -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- RecyclerView Daftar Kartu Draft Resep -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDraftResep"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_draft_card"
            tools:itemCount="3" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/pbLoadingDraft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#802C3E"
            android:visibility="gone" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmptyDraft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Belum ada draft resep tersimpan."
            android:textColor="#8D6E63"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
