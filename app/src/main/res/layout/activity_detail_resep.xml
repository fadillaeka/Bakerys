<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F8">

    <!-- 1. Konten yang Bisa di-Scroll (Berada di atas Bottom Navigation) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav_main"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Foto Resep Utama -->
            <ImageView
                android:id="@+id/ivDetailThumb"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:scaleType="centerCrop"
                android:src="@drawable/cookies"
                android:contentDescription="Thumbnail Resep" />

            <!-- Informasi Resep & Bahan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No-Bake Pumpkin Cheesecake Bars"
                    android:textColor="#3E2723"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Oleh Author"
                    android:textColor="#8D6E63"
                    android:textSize="12sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#802C3E"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvWaktuMemasak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="⏱️ 50 Menit"
                        android:textColor="#FFF9F8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Tentang Resep"
                    android:textColor="#3E2723"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTentangResep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Resep No-Bake Pumpkin Cheesecake Bars ini terdiri dari lapisan dasar biskuit graham dengan isian cheesecake labu yang lembut dan krim kocok manis ."
                    android:textColor="#5D4037"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Bahan - Bahan"
                    android:textColor="#3E2723"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="#D7B5AE" />

                <!-- Tombol Tab Bahan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabBahanUtama"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="#FCEBE5"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="2dp"
                        android:text="Bahan Utama"
                        android:textAllCaps="false"
                        android:textColor="#802C3E"
                        android:textSize="12sp"
                        app:cornerRadius="20dp"
                        app:strokeColor="#D7B5AE"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabTakaranSendok"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:backgroundTint="#802C3E"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="2dp"
                        android:text="Takaran Sendok"
                        android:textAllCaps="false"
                        android:textColor="#FFF9F8"
                        android:textSize="12sp"
                        app:cornerRadius="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabTakaranGram"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:backgroundTint="#FCEBE5"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="2dp"
                        android:text="Takaran Gram"
                        android:textAllCaps="false"
                        android:textColor="#802C3E"
                        android:textSize="12sp"
                        app:cornerRadius="20dp"
                        app:strokeColor="#D7B5AE"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FCEBE5"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D7B5AE"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvBahanKiri"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:lineSpacingExtra="4dp"
                            android:text="• 1 1/4 cangkir remahan biskuit graham\n• 1/3 cangkir mentega cair\n• 2 sendok makan gula pasir\n• 1 kaleng (15 ons) labu\n• 1 kemasan (8 ons) keju krim\n• 1 sendok makan gula merah"
                            android:textColor="#3E2723"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvBahanKanan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:lineSpacingExtra="4dp"
                            android:text="• 2 sendok teh bumbu pai labu\n• 8 ons cokelat putih\n• 3/4 cangkir krim kental\n• 1/4 cangkir gula halus\n• 1/2 sendok teh ekstrak vanila"
                            android:textColor="#3E2723"
                            android:textSize="12sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="#802C3E"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Bahan Pengganti"
                        android:textColor="#FFF9F8"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    app:cardBackgroundColor="#FCEBE5"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D7B5AE"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvBahanPengganti"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="• Mentega cair dapat diganti dengan minyak kelapa cair."
                        android:textColor="#3E2723"
                        android:textSize="12sp" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Section Langkah Memasak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#802C3E"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Langkah Memasak →"
                        android:textColor="#FFF9F8"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnTimer"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/bell"
                        app:tint="#FFF9F8"
                        android:contentDescription="Timer" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_circle_peach" android:gravity="center" android:text="1" android:textColor="#802C3E" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:id="@+id/tvLangkah1" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="45dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/bg_ffd2be_input" android:padding="12dp" android:gravity="center_vertical" android:textColor="#3E2723" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_circle_peach" android:gravity="center" android:text="2" android:textColor="#802C3E" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:id="@+id/tvLangkah2" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="45dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/bg_ffd2be_input" android:padding="12dp" android:gravity="center_vertical" android:textColor="#3E2723" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_circle_peach" android:gravity="center" android:text="3" android:textColor="#802C3E" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:id="@+id/tvLangkah3" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="45dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/bg_ffd2be_input" android:padding="12dp" android:gravity="center_vertical" android:textColor="#3E2723" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_circle_peach" android:gravity="center" android:text="4" android:textColor="#802C3E" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:id="@+id/tvLangkah4" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="45dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/bg_ffd2be_input" android:padding="12dp" android:gravity="center_vertical" android:textColor="#3E2723" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_circle_peach" android:gravity="center" android:text="5" android:textColor="#802C3E" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:id="@+id/tvLangkah5" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="45dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/bg_ffd2be_input" android:padding="12dp" android:gravity="center_vertical" android:textColor="#3E2723" android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 2. Bottom Navigation Bar Terkunci (Fixed) di Paling Bawah Layar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFF9F8"
        app:itemIconTint="@color/selector_bottom_nav"
        app:itemTextColor="@color/selector_bottom_nav"
        app:itemActiveIndicatorStyle="@style/CustomActiveIndicator"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled" />

</RelativeLayout>