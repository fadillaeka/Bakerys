<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FCEBE5"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#EED5CE"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- Gambar Makanan / Resep -->
        <ImageView
            android:id="@+id/imgDraft"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_circle_peach"
            android:scaleType="centerCrop"
            android:src="@drawable/bakery_mark"
            android:contentDescription="Gambar Resep" />

        <!-- Judul Resep Draft -->
        <TextView
            android:id="@+id/tvJudulDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgDraft"
            android:layout_marginStart="14dp"
            android:layout_alignParentTop="true"
            android:text="Nama Resep Draft"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Tombol Lihat Resep -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHapusDraft"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:backgroundTint="#F8CFBE"
            android:text="Hapus Draft"
            android:textAllCaps="false"
            android:textColor="#802C3E"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#E4B7A5"
            app:strokeWidth="1dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>