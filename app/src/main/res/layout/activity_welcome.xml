<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCEBE5">

    <ImageView
        android:id="@+id/ivBackgroundWelcome"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_pastry_login"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_gradient_transparent_to_peach"
        app:layout_constraintBottom_toBottomOf="@id/ivBackgroundWelcome" />

    <ImageView
        android:id="@+id/ivLogoWelcome"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="40dp"
        android:src="@mipmap/ic_launcher_foreground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvQuote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Resep lengkap, takaran akurat, hasil lezat. Mulai panggang kue favoritmu sekarang!"
        android:textColor="#802C3E"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivBackgroundWelcome" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLoginWelcome"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#802C3E"
        android:text="Login"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuote" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDaftarWelcome"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#802C3E"
        android:text="Daftar"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnLoginWelcome" />

</androidx.constraintlayout.widget.ConstraintLayout>