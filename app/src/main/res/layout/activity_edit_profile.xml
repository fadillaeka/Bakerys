<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header Atas (Logo & Judul) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bakery_mark"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Edit Profil"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bagian Foto Profil & Tombol Kamera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp">

                <ImageView
                    android:id="@+id/ivFotoProfil"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_peach"
                    android:scaleType="centerCrop"
                    android:src="@drawable/circle_user_round"
                    android:contentDescription="Foto Profil" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUbahFoto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    app:cardBackgroundColor="#802C3E"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#FFF9F8"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera"
                        app:tint="#FFF9F8"
                        android:contentDescription="Ubah Foto" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUbahFoto"
                android:layout_width="wrap_content"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#802C3E"
                android:text="Ubah Foto Profile"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- Container Formulir Berwarna Maroon (Gap diperluas agar tidak dempet) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#802C3E"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informasi Pribadi"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:background="#D7B5AE" />

            <!-- Nama Lengkap -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Nama Lengkap"
                android:textColor="#FFF9F8"
                android:textSize="12sp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_ffd2be_input"
                android:hint="Contoh : Kim Namjoon"
                android:paddingHorizontal="16dp"
                android:textColor="#3E2723"
                android:textColorHint="#7A4F57"
                android:textSize="13sp" />

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Username"
                android:textColor="#FFF9F8"
                android:textSize="12sp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_ffd2be_input"
                android:hint="Contoh : Kim Namjoon"
                android:paddingHorizontal="16dp"
                android:textColor="#3E2723"
                android:textColorHint="#7A4F57"
                android:textSize="13sp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Email"
                android:textColor="#FFF9F8"
                android:textSize="12sp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_ffd2be_input"
                android:hint="Contoh : BelanjaSapi@gmail.com"
                android:paddingHorizontal="16dp"
                android:textColor="#3E2723"
                android:textColorHint="#7A4F57"
                android:textSize="13sp" />

            <!-- Bio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Bio"
                android:textColor="#FFF9F8"
                android:textSize="12sp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_ffd2be_input"
                android:gravity="top|start"
                android:hint="Hobi membuat kue"
                android:padding="16dp"
                android:textColor="#3E2723"
                android:textColorHint="#7A4F57"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Tombol Aksi Bawah -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpan"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#802C3E"
                android:text="Simpan Perubahan"
                android:textAllCaps="false"
                android:textColor="#FFF9F8"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKembali"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Kembali"
                android:textAllCaps="false"
                android:textColor="#802C3E"
                app:cornerRadius="16dp"
                app:strokeColor="#802C3E" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>