<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <!-- Header Atas (Logo & Judul) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bakery_mark"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Unggah"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kotak Upload Foto Resep (Garis Putus-putus) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#802C3E"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#802C3E"
                    android:contentDescription="Kamera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Upload foto resep anda"
                    android:textColor="#802C3E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="JPG, PNG max 5 mb"
                    android:textColor="#A06A75"
                    android:textSize="10sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Form Nama Resep -->
        <TextView android:text="Nama Resep *" android:textColor="#802C3E" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etJudul"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_ffd2be_input"
            android:hint="Masukkan Nama Resep"
            android:paddingHorizontal="16dp"
            android:textColor="#3E2723"
            android:textSize="13sp" />

        <!-- Form Deskripsi Resep -->
        <TextView android:text="Deskripsi Resep" android:textColor="#802C3E" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_ffd2be_input"
            android:hint="Masukkan Deskripsi"
            android:paddingHorizontal="16dp"
            android:textColor="#3E2723"
            android:textSize="13sp" />

        <!-- Baris Waktu Panggang & Porsi (Berdampingan) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:text="Waktu Panggang" android:textColor="#802C3E" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ffd2be_input"
                    android:hint="Estimasi waktu"
                    android:paddingHorizontal="16dp"
                    android:textColor="#3E2723"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView android:text="Porsi" android:textColor="#802C3E" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ffd2be_input"
                    android:hint="Banyk Porsi"
                    android:paddingHorizontal="16dp"
                    android:textColor="#3E2723"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Baris Bahan-bahan * (Bahan Utama & Bahan Pengganti Berdampingan) -->
        <TextView android:text="Bahan-bahan *" android:textColor="#802C3E" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <!-- Bahan Utama -->
            <EditText
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ffd2be_input"
                android:gravity="top|start"
                android:hint="Bahan Utama"
                android:padding="12dp"
                android:textColor="#3E2723"
                android:textColorHint="#A06A75"
                android:textSize="12sp" />

            <!-- Bahan Pengganti -->
            <EditText
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_ffd2be_input"
                android:gravity="top|start"
                android:hint="Bahan Pengganti"
                android:padding="12dp"
                android:textColor="#3E2723"
                android:textColorHint="#A06A75"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Form Langkah Memasak * -->
        <TextView android:text="Langkah Memasak *" android:textColor="#802C3E" android:textSize="12sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_ffd2be_input"
            android:gravity="top|start"
            android:hint="Tulis Langkah Membuat"
            android:padding="12dp"
            android:textColor="#3E2723"
            android:textSize="13sp" />

        <!-- Tombol Aksi Bawah (Publikasikan & Simpan Draft) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPublikasikan"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#802C3E"
                android:text="Publikasikan Resep"
                android:textAllCaps="false"
                android:textColor="#FFF9F8"
                android:textSize="12sp"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpanDraft"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:backgroundTint="#802C3E"
                android:text="Simpan Sebagai Draft"
                android:textAllCaps="false"
                android:textColor="#FFF9F8"
                android:textSize="12sp"
                app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>