<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Judul Halaman -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bakery_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Unggah Postingan"
                android:textColor="#791E2A"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Area Upload Foto -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUploadFoto"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FCEAE6"
            app:cardCornerRadius="16dp"
            app:strokeColor="#791E2A"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivPreviewFoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#791E2A" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Label Caption -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caption Postingan *"
            android:textColor="#791E2A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Input Caption tunggal -->
        <EditText
            android:id="@+id/etCaption"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="Tuliskan caption postingan kamu..."
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="#3E2723"
            android:textColorHint="#BCAAA4"
            android:textSize="14sp" />

        <!-- Tombol Aksi (Draft & Publikasikan) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSimpanDraft"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#FCEAE6"
                android:text="Simpan Draft"
                android:textColor="#791E2A"
                android:textStyle="bold"
                app:cornerRadius="24dp" />

            <Button
                android:id="@+id/btnPublikasikan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#791E2A"
                android:text="Publikasikan"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="24dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>