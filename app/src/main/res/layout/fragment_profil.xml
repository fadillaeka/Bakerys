<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <!-- Header Profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bakery_mark"
                android:contentDescription="Logo Bakerys" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Profil"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kartu Utama Profil -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EED5CE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- WADAH FOTO PROFIL BULAT PERMANEN -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#802C3E"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/ivFotoProfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/circle_user_round"
                        android:contentDescription="Foto Profil" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Nama Pengguna -->
                <TextView
                    android:id="@+id/tvNamaUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Belanja Sapi"
                    android:textColor="#3E2723"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Bio Singkat -->
                <TextView
                    android:id="@+id/tvBioUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Baking enthusiast 🥐 • Bakery's App"
                    android:textColor="#8D6E63"
                    android:textSize="12sp" />

                <!-- Tombol Edit Profile -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#802C3E"
                    android:text="Edit Profile"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />

                <!-- Statistik (Terunggah & Draft) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvJumlahTerunggah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12"
                            android:textColor="#802C3E"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resep Terunggah"
                            android:textColor="#8D6E63"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvJumlahDraft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="#802C3E"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Draft"
                            android:textColor="#8D6E63"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bagian Preferensi Pemanggangan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Preferensi Pemanggangan"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#EED5CE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pengukuran Satuan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengukuran Satuan"
                    android:textColor="#3E2723"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Metric -->
                    <LinearLayout
                        android:id="@+id/btnMetric"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="#802C3E"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvMetric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Metric (Gram/ml)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Sendok / Imperial -->
                    <LinearLayout
                        android:id="@+id/btnImperial"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvImperial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sendok (Cangkir/ons)"
                            android:textColor="#802C3E"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Standar Suhu Oven -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Standar Suhu Oven"
                    android:textColor="#3E2723"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Celcius -->
                    <LinearLayout
                        android:id="@+id/btnCelcius"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="#802C3E"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvCelcius"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Celcius (°C)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Fahrenheit -->
                    <LinearLayout
                        android:id="@+id/btnFahrenheit"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvFahrenheit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farenheit (°F)"
                            android:textColor="#802C3E"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bagian Alat & Preferensi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Alat &amp; Preferensi"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#EED5CE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Menu Draft -->
                <LinearLayout
                    android:id="@+id/btnDraftResep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Draft"
                        android:textColor="#3E2723"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#3E2723" />
                </LinearLayout>

                <!-- Garis Pemisah (Divider) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#EED5CE" />

                <!-- Menu Disukai -->
                <LinearLayout
                    android:id="@+id/btnDisukai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Disukai"
                        android:textColor="#3E2723"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#3E2723" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bagian Tim Pengembang (Kelompok) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Tim Pengembang (Kelompok)"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTimKelompok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#EED5CE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Tim -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/group"
                        app:tint="#802C3E"
                        android:contentDescription="Team Icon" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kelompok Bakery's"
                            android:textColor="#802C3E"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anggota Tim Pengembang Aplikasi"
                            android:textColor="#8D6E63"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EED5CE"
                    android:layout_marginBottom="10dp" />

                <!-- Anggota 1: Wapa Tsuraya R. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_peach"
                        android:backgroundTint="#802C3E"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/tvNamaAnggota1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wapa Tsuraya R."
                            android:textColor="#3E2723"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvRoleAnggota1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NIM: 246651038"
                            android:textColor="#8D6E63"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Anggota 2: Syarifah Alsya Zahra -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_peach"
                        android:backgroundTint="#802C3E"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/tvNamaAnggota2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Syarifah Alsya Zahra"
                            android:textColor="#3E2723"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvRoleAnggota2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NIM: 246651040"
                            android:textColor="#8D6E63"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Anggota 3: Fadilla Eka Putri -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_peach"
                        android:backgroundTint="#802C3E"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/tvNamaAnggota3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fadilla Eka Putri"
                            android:textColor="#3E2723"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvRoleAnggota3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NIM: 246651041"
                            android:textColor="#8D6E63"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Anggota 4: Fatimah Azzahra Putri -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_peach"
                        android:backgroundTint="#802C3E"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/tvNamaAnggota4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fatimah Azzahra Putri"
                            android:textColor="#3E2723"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvRoleAnggota4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NIM: 246651044"
                            android:textColor="#8D6E63"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Anggota 5: Salsabila Oktavia Ramadani -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp">
                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_peach"
                        android:backgroundTint="#802C3E"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/tvNamaAnggota5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salsabila Oktavia Ramadani"
                            android:textColor="#3E2723"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvRoleAnggota5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NIM: 246651056"
                            android:textColor="#8D6E63"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Log Out -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#802C3E"
            android:text="Log Out"
            android:textAllCaps="false"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>