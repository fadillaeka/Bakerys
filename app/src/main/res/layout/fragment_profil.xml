<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <!-- Header Profil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bakery_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Profil"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kartu Utama Profil -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EED5CE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Foto Profil Bulat -->
                <ImageView
                    android:id="@+id/imgFotoProfil"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/bg_circle_peach"
                    android:scaleType="centerCrop"
                    android:src="@drawable/circle_user_round" />

                <!-- Nama Pengguna -->
                <TextView
                    android:id="@+id/tvNamaUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Belanja Sapi"
                    android:textColor="#3E2723"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Bio Singkat -->
                <TextView
                    android:id="@+id/tvBioUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="disini ada 5 cewek syantik.\nalsa, pia, putri, dilo, dan wapa"
                    android:textColor="#8D6E63"
                    android:textSize="12sp" />

                <!-- Tombol Edit Profile -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#802C3E"
                    android:text="Edit Profile"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="16dp" />

                <!-- Statistik (Terunggah, Disimpan, Draft) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvJumlahTerunggah" android:text="12" android:textStyle="bold" android:textColor="#802C3E" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Resep Terunggah" android:textColor="#8D6E63" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvJumlahDisimpan" android:text="48" android:textStyle="bold" android:textColor="#802C3E" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Resep Disimpan" android:textColor="#8D6E63" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvJumlahDraft" android:text="5" android:textStyle="bold" android:textColor="#802C3E" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <TextView android:text="Draft Resep" android:textColor="#8D6E63" android:textSize="10sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bagian Preferensi Pemanggangan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Preferensi Pemanggangan"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#EED5CE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pengukuran Satuan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengukuran Satuan"
                    android:textColor="#3E2723"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Metric -->
                    <LinearLayout
                        android:id="@+id/btnMetric"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="#802C3E"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvMetric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Metric (Gram/ml)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Sendok / Imperial -->
                    <LinearLayout
                        android:id="@+id/btnImperial"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvImperial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sendok (Cangkir/ons)"
                            android:textColor="#802C3E"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Standar Suhu Oven -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Standar Suhu Oven"
                    android:textColor="#3E2723"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- Celcius -->
                    <LinearLayout
                        android:id="@+id/btnCelcius"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:backgroundTint="#802C3E"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvCelcius"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Celcius (°C)"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Fahrenheit -->
                    <LinearLayout
                        android:id="@+id/btnFahrenheit"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvFahrenheit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Farenheit (°F)"
                            android:textColor="#802C3E"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bagian Alat & Preferensi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Alat &amp; Preferensi"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FCEBE5"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#EED5CE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Menu Resep Disimpan -->
                <LinearLayout
                    android:id="@+id/btnResepDisimpan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Resep Disimpan"
                        android:textColor="#3E2723"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#3E2723" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#EED5CE" />

                <!-- Menu Draft Resep -->
                <LinearLayout
                    android:id="@+id/btnDraftResep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Draft Resep"
                        android:textColor="#3E2723"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#3E2723" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol Log Out -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#802C3E"
            android:text="Log Out"
            android:textAllCaps="false"
            app:cornerRadius="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>