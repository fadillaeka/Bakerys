<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F8"
    android:orientation="vertical">

    <!-- Header Halaman Draft Postingan (konsisten dengan activity_draft_resep.xml) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/bakery_mark"
            android:contentDescription="Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Draft Postingan"
                android:textColor="#3E2723"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar postingan yang belum dipublikasikan"
                android:textColor="#8D6E63"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tombol Reload -->
        <ImageView
            android:id="@+id/btnRefreshDraftPostingan"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#802C3E"
            android:contentDescription="Muat Ulang" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EED5CE" />

    <!-- Kontainer List Draft -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- RecyclerView Daftar Kartu Draft -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDraft"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:nestedScrollingEnabled="true"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_draft_card"
            tools:itemCount="4" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/pbLoadingDraftPostingan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#802C3E"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyDraftPostingan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/bakery_mark"
                app:tint="#D7B5AE"
                android:contentDescription="Tidak ada draft" />

            <TextView
                android:id="@+id/tvEmptyDraftPostingan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Belum Ada Draft Postingan"
                android:textColor="#3E2723"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Postingan yang Anda simpan sebagai draf akan muncul di sini."
                android:textColor="#8D6E63"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>